{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "env": { "RELAIS_URL": "https://relais-server.onrender.com" },
      "ios": { "simulator": false }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "RELAIS_URL": "https://relais-server.onrender.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "rom.clavel@icloud.com",
        "ascAppId": "6791576736",
        "appleTeamId": "9S32X2PTHR"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal"
      }
    }
  }
}
