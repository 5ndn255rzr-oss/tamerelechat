{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "env": { "RELAIS_URL": "https://relais-server.onrender.com" },
      "ios": { "simulator": false }
    },
    "production": {
      "autoIncrement": true,
      "env": { "RELAIS_URL": "https://relais-server.onrender.com" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "REMPLACE_PAR_TON_EMAIL_APPLE",
        "ascAppId": "REMPLACE_PAR_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REMPLACE_PAR_TON_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal"
      }
    }
  }
}
